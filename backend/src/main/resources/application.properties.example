spring.application.name=document-vault-backend

spring.datasource.url=jdbc:mysql://localhost:3306/document_vault
spring.datasource.username=your_username
spring.datasource.password=your_password

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

server.port=8080

jwt.secret=replace-with-64-character-secret
jwt.expiration=86400000